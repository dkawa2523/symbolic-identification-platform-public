FROM python@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS rasr
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates fonts-dejavu-core fonts-noto-cjk build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir uv==0.11.16
RUN git clone https://github.com/automl/rasr.git /opt/rasr \
    && git -C /opt/rasr checkout f7bdf878a46f0a691d55146d7b4cf1ddac605db7 \
    && git -C /opt/rasr submodule update --init torchtitan
WORKDIR /opt/rasr
# Use the official resolved dependency lock and its CPU group, not a mixed Flash environment.
RUN uv sync --frozen --no-default-groups --group cpu
# SimpliPy 0.2.14 imports this undeclared runtime dependency.
RUN uv pip install --python /opt/rasr/.venv/bin/python platformdirs==4.13.5 pytest==8.3.5
COPY pkgs/symbolic/src/ml_platform_symbolic/engines/rasr_runtime.py /tmp/rasr_runtime.py
RUN /opt/rasr/.venv/bin/python /tmp/rasr_runtime.py --directory /opt/rasr/src/rasr/inference
COPY pkgs/symbolic /opt/symbolic
RUN uv pip install --python /opt/rasr/.venv/bin/python \
    'ml-platform-core @ git+https://github.com/dkawa2523/ml_platform.git@91aa29a235527b9ecd6fc7f6d17101beb0cfe9a0#subdirectory=pkgs/core' -e /opt/symbolic
ENV PATH="/opt/rasr/.venv/bin:${PATH}" \
    PYTHONPATH="/work/pkgs/symbolic/src:/opt/rasr" \
    PYTHONDONTWRITEBYTECODE=1 \
    WANDB_MODE=disabled
WORKDIR /work
CMD ["python", "-m", "ml_platform_symbolic", "--help"]
