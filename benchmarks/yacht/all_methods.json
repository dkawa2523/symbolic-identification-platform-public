{
  "task": "symbolic_pipeline",
  "data": {
    "local_path": "data/yacht/table.csv",
    "target_column": "resistance",
    "feature_columns": [
      "buoyancy_position",
      "prismatic_coefficient",
      "length_displacement_ratio",
      "beam_draught_ratio",
      "length_beam_ratio",
      "froude"
    ],
    "units": {
      "buoyancy_position": "1",
      "prismatic_coefficient": "1",
      "length_displacement_ratio": "1",
      "beam_draught_ratio": "1",
      "length_beam_ratio": "1",
      "froude": "1",
      "resistance": "1"
    }
  },
  "split": {
    "file": "data/yacht/split.csv",
    "group_column": "group_id"
  },
  "search": {
    "engines": [
      "mean",
      "linear",
      "dictionary",
      "pysr",
      "physo",
      "torchsisso",
      "proged",
      "parfam",
      "pse",
      "flash_ansr",
      "rasr",
      "pysips",
      "e2e"
    ],
    "seeds": [
      42
    ],
    "operators": [
      "add",
      "sub",
      "mul",
      "div",
      "neg",
      "abs",
      "exp",
      "log",
      "sqrt",
      "pow_int",
      "sin",
      "cos",
      "tanh",
      "sinh",
      "cosh"
    ],
    "max_wall_seconds": 300,
    "max_export_candidates": 20,
    "allow_partial_engines": true,
    "runtimes": {
      "pse": {
        "device": "cuda"
      },
      "e2e": {
        "device": "cpu"
      }
    },
    "engine_options": {
      "pysips": {
        "particles": 6,
        "mcmc_samples": 1,
        "max_complexity": 5,
        "seconds": 10
      },
      "pysr": {
        "niterations": 12,
        "populations": 3,
        "ncycles_per_iteration": 80
      },
      "physo": {
        "epochs": 5,
        "batch_size": 128,
        "max_n_evaluations": 640
      },
      "torchsisso": {
        "n_expansion": 2,
        "n_term": 3,
        "k": 10
      },
      "proged": {
        "template": "polynomial",
        "sample_size": 10,
        "depth_limit": 8,
        "max_attempts": 40
      },
      "parfam": {
        "degree": 1,
        "maxiter": 5,
        "repetitions": 1,
        "max_active_parameters": 7
      },
      "pse": {
        "layers": 2,
        "slots": 2,
        "seconds": 10,
        "top_k": 3
      },
      "flash_ansr": {
        "draws": 64
      },
      "rasr": {
        "candidates": 16,
        "decode_batch_size": 4,
        "restarts": 1
      },
      "e2e": {
        "beam_size": 8,
        "max_input_points": 200,
        "n_trees_to_refine": 8,
        "refinement_seconds": 2,
        "max_generated_output_len": 128
      }
    }
  },
  "model_assets": {
    "flash_ansr": {
      "manifest_file": "pretrained/flash/manifest.json"
    },
    "rasr": {
      "manifest_file": "pretrained/rasr/manifest.json"
    },
    "e2e": {
      "manifest_file": "pretrained/e2e/manifest.json"
    }
  },
  "constraints": {
    "max_nodes": 60
  },
  "evaluation": {
    "selection_policy": "balanced",
    "absolute_tolerance": 1e-06
  }
}
