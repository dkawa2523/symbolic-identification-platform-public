{
  "search": {
    "operators": ["add", "sub", "mul", "div", "neg", "abs", "sqrt", "pow_int", "pow", "rootn", "sin", "cos", "exp", "log", "tanh"],
    "engine_options": {
      "pysr": {"niterations": 100, "populations": 8, "population_size": 40, "ncycles_per_iteration": 200, "seconds": 90, "maxdepth": 15,
        "operator_constraints": {"div": [-1, 8], "sin": 8, "cos": 8, "pow_int": 8},
        "nested_constraints": {"sin": {"sin": 0, "cos": 0}, "cos": {"sin": 0, "cos": 0}}},
      "proged": {"sample_size": 80, "depth_limit": 8, "max_attempts": 600, "max_constants": 6, "optimizer": "DE", "optimizer_iterations": 20, "optimizer_population": 16},
      "flash_ansr": {"draws": 128},
      "rasr": {"candidates": 32, "decode_batch_size": 8, "restarts": 2}
    }
  },
  "model_assets": {
    "flash_ansr": {"manifest_file": "pretrained/flash/manifest.json"},
    "rasr": {"manifest_file": "pretrained/rasr/manifest.json"}
  },
  "constraints": {"max_nodes": 60},
  "evaluation": {"coefficient_fit": "none", "selection_policy": "balanced", "relative_tolerance": 0.01, "absolute_tolerance": 0.000001}
}
