{
  "search": {
    "operators": ["add", "sub", "mul", "div", "neg", "sqrt", "pow_int", "pow", "exp", "log"],
    "engine_options": {
      "pysr": {
        "niterations": 100, "populations": 8, "population_size": 40,
        "ncycles_per_iteration": 200, "seconds": 120, "maxdepth": 15,
        "operator_constraints": {"div": [-1, 12], "pow_int": 12}
      },
      "physo": {"epochs": 20, "batch_size": 256, "max_n_evaluations": 5120}
    }
  },
  "constraints": {"max_nodes": 60, "require_units": false},
  "evaluation": {"coefficient_fit": "none", "selection_policy": "balanced", "relative_tolerance": 0.01, "absolute_tolerance": 0.0}
}
