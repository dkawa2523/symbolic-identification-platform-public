{
  "task": "symbolic_pipeline",
  "data": {
    "local_path": "data/yacht/table.csv",
    "target_column": "resistance",
    "feature_columns": [
      "buoyancy_position",
      "prismatic_coefficient",
      "length_displacement_ratio",
      "beam_draught_ratio",
      "length_beam_ratio",
      "froude"
    ],
    "units": {
      "buoyancy_position": "1",
      "prismatic_coefficient": "1",
      "length_displacement_ratio": "1",
      "beam_draught_ratio": "1",
      "length_beam_ratio": "1",
      "froude": "1",
      "resistance": "1"
    }
  },
  "split": {
    "file": "data/yacht/split.csv",
    "group_column": "group_id"
  },
  "search": {
    "engines": [
      "mean",
      "linear"
    ],
    "seeds": [
      42
    ],
    "operators": [
      "add",
      "sub",
      "mul",
      "div",
      "neg",
      "abs",
      "exp",
      "log",
      "sqrt",
      "pow_int",
      "sin",
      "cos",
      "tanh",
      "sinh",
      "cosh"
    ],
    "max_wall_seconds": 3600,
    "max_export_candidates": 20,
    "allow_partial_engines": true,
    "runtimes": {},
    "engine_options": {
      "mean": {},
      "linear": {}
    },
    "candidate_pool_policy": "all"
  },
  "model_assets": {},
  "constraints": {
    "max_nodes": 256
  },
  "evaluation": {
    "selection_policy": "accuracy",
    "absolute_tolerance": 1e-06
  }
}