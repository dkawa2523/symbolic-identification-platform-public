{
  "task": "symbolic_pipeline",
  "data": {
    "local_path": "results/practical-fixed-20261115-1400/inputs/synthetic/table.csv",
    "target_column": "y",
    "feature_columns": [
      "x"
    ],
    "units": {
      "x": "1",
      "y": "1"
    },
    "domain": {
      "x": [
        0.1,
        4
      ]
    }
  },
  "split": {
    "file": "results/practical-fixed-20261115-1400/inputs/synthetic/split.csv"
  },
  "search": {
    "engines": [
      "e2e"
    ],
    "seeds": [
      17
    ],
    "operators": [
      "add",
      "sub",
      "mul",
      "div"
    ],
    "max_wall_seconds": 21600,
    "candidate_pool_policy": "all",
    "max_export_candidates": 20,
    "allow_partial_engines": true,
    "engine_options": {
      "e2e": {
        "beam_size": 64,
        "n_trees_to_refine": 64,
        "max_input_points": 200,
        "max_train_rows": null,
        "generation_batch_size": 1,
        "refinement_seconds": 5,
        "max_generated_output_len": 128,
        "operator_mask": true,
        "response_max_nfev": 1000
      }
    },
    "runtimes": {
      "e2e": {
        "device": "cpu"
      }
    }
  },
  "constraints": {
    "max_nodes": 256
  },
  "model_assets": {
    "e2e": {
      "manifest_file": "pretrained/e2e/manifest.json"
    }
  },
  "evaluation": {
    "selection_policy": "accuracy",
    "absolute_tolerance": 1e-06
  }
}